# Copy to .env.server. This file is loaded only by server and local administration commands.
# Never use VITE_ prefixes for backend secrets.
SITE_DATA_DIR=./server/.local/data
SITE_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
AMAP_WEB_KEY=
AMAP_SERVICE_KEY=
AMAP_SECURITY_CODE=
# Optional: absolute path to an existing system FFmpeg (leave blank to use ffmpeg-static).
FFMPEG_BIN=
