# Copy to .env.server. This file is loaded only by server and local administration commands.
# Never use VITE_ prefixes for backend secrets.
SITE_DATA_DIR=./server/.local/data
SITE_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
# Optional AMap credentials: each deployer obtains their own keys.
# Web platform (JS API) Key: interactive map in the public website.
AMAP_WEB_KEY=
# Web service Key (a separate Key): owner POI search, geocoding and coordinate conversion.
AMAP_SERVICE_KEY=
# Security code (jscode) paired with AMAP_WEB_KEY; kept in the server-side proxy.
AMAP_SECURITY_CODE=
# Optional: absolute path to an existing system FFmpeg (leave blank to use ffmpeg-static).
FFMPEG_BIN=
