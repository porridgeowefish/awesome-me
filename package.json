{
  "name": "awesome-me",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --import tsx server/start.ts",
    "start": "node --import tsx server/start.ts",
    "owner:init": "tsx server/commands/init-owner.ts",
    "content:migrate": "tsx server/commands/migrate.ts",
    "site": "node tools/cli/site-cli.mjs",
    "skill:install": "tsx server/commands/install-skill.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "media": "node tools/scripts/optimize-images.mjs",
    "import:notes": "node tools/scripts/import-obsidian.mjs",
    "dev:full": "node tools/scripts/dev.mjs",
    "backup": "tsx server/commands/backup.ts",
    "restore": "tsx server/commands/restore.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "check:delivery": "node tools/scripts/check-delivery.mjs",
    "check:privacy": "node tools/scripts/check-privacy.mjs",
    "check:release": "npm run verify && npm run check:delivery && npm run check:privacy"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.5",
    "@fontsource/silkscreen": "^5.3.0",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-mathematics": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.16",
    "exifr": "^7.1.3",
    "fastify": "^5.12.5",
    "ffmpeg-static": "5.3.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "mammoth": "^1.13.0",
    "mermaid": "^12.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-rehype": "^11.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.14 <25"
  },
  "description": "A self-hosted personal website and content studio with demo data.",
  "license": "MIT"
}
